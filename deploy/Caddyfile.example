# Host reverse proxy for prod + UAT on one VPS.
# Install Caddy, copy this to /etc/caddy/Caddyfile, then: systemctl reload caddy
#
# DNS A records (both to the same VPS IP):
#   shop.omuwenga.com
#   api.omuwenga.com
#   uat.omuwenga.com

shop.omuwenga.com {
	# Match fe/nginx.conf — M-Pesa receipt multipart can exceed 1 MiB.
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:3000
}

# Public API for the marketing site. The backend container stays on localhost:8000.
api.omuwenga.com {
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8000
}

uat.omuwenga.com {
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:3100
}

api.uat.omuwenga.com {
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8001
}
