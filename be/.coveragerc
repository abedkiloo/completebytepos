[run]
source = .
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */management/commands/*
    */venv/*
    manage.py
    config/*
    */apps.py
    qrcode.py
    */qrcode.py

[report]
show_missing = True
skip_covered = False
precision = 1
# Whole-tree statement floor. Per-module gates: ./run_tests_coverage.sh --gates
fail_under = 98

[html]
directory = htmlcov
