[run]
source = .
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */management/commands/*
    */venv/*
    manage.py
    config/*
    */apps.py
    qrcode.py
    */qrcode.py

[report]
show_missing = True
skip_covered = False
precision = 1
# Per-module gates: use run_tests_coverage.sh; raise fail_under when whole BE ≥ 75%.
fail_under = 0

[html]
directory = htmlcov
