# Local manage.py (Postgres on host). Workspace Docker uses root .env.example

DEBUG=True
SECRET_KEY=change-me
# Required when DEBUG=False — never leave the insecure Django default.
ALLOWED_HOSTS=localhost,127.0.0.1

# Destructive wipe of an already-installed DB (default: blocked).
ALLOW_DESTRUCTIVE_FRESH_INSTALL=False
FRESH_INSTALL_SECRET=

# Optional Daraja callback hardening (set in production).
DARAJA_CALLBACK_SECRET=
DARAJA_CALLBACK_IPS=

# Optional: require session/JWT before serving /media/ (breaks bare <img src>).
# MEDIA_REQUIRE_AUTH=False

THROTTLE_LOGIN_RATE=10/min
THROTTLE_SMS_BLAST_RATE=5/hour

POSTGRES_DB=completebytepos
POSTGRES_USER=completebytepos
POSTGRES_PASSWORD=completebytepos

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=completebytepos
DB_USER=completebytepos
DB_PASSWORD=completebytepos

TIME_ZONE=Africa/Nairobi
DEFAULT_PHONE_COUNTRY_CODE=254
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
