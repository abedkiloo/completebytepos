# UAT stack on the same VPS as production.
#   cp .env.uat.example .env.uat
#   ./run_uat.sh
#
# DNS A records (same VPS IP as shop):
#   uat.omuwenga.com      frontend
#   api.uat.omuwenga.com  backend (Gunicorn / admin)
# Host reverse proxy: see deploy/Caddyfile.example.

DEBUG=False
SECRET_KEY=replace-with-a-different-long-random-secret-from-prod

STACK_NAME=omuwenga-uat
COMPOSE_ENV_FILE=.env.uat

PUBLIC_HOST=uat.omuwenga.com
ALLOWED_HOSTS=uat.omuwenga.com,api.uat.omuwenga.com,localhost,127.0.0.1,backend,omuwenga-uat_backend

# Own database — never reuse prod POSTGRES_* / volume.
POSTGRES_DB=completebytepos_uat
POSTGRES_USER=completebytepos_uat
POSTGRES_PASSWORD=replace-with-strong-uat-password
# Host bind for psql from the VPS (127.0.0.1:5435). Django uses db:5432 on the Docker network.
POSTGRES_PORT=5435

DB_HOST=db
DB_PORT=5432
DB_NAME=completebytepos_uat
DB_USER=completebytepos_uat
DB_PASSWORD=replace-with-strong-uat-password
DB_CONN_MAX_AGE=300

# Leave RAM for production on a ~2 GB box.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=800

POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB

LANGUAGE_CODE=en-us
TIME_ZONE=Africa/Nairobi
DEFAULT_PHONE_COUNTRY_CODE=254

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://uat.omuwenga.com,http://uat.omuwenga.com,https://api.uat.omuwenga.com,http://api.uat.omuwenga.com
CSRF_TRUSTED_ORIGINS=https://uat.omuwenga.com,http://uat.omuwenga.com,https://api.uat.omuwenga.com,http://api.uat.omuwenga.com

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
USE_SECURE_PROXY_SSL_HEADER=True

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

REACT_APP_API_URL=/api
FRONTEND_PORT=3100
BACKEND_PORT=8001

LOG_LEVEL=INFO

# SQL dumps on the host disk, separate from production backups.
BACKUP_HOST_DIR=./backups/uat
BACKUP_INTERVAL_DAYS=14
BACKUP_KEEP=8
