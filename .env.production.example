# Production template — copy to .env
#   cp .env.production.example .env

DEBUG=False
SECRET_KEY=replace-with-long-random-secret

# Domain used by browsers (HTTPS). Also merged into ALLOWED_HOSTS automatically.
# Example: shop.omuwenga.com — omitting this causes Django 400 Bad Request on /api.
PUBLIC_HOST=shop.omuwenga.com
ALLOWED_HOSTS=shop.omuwenga.com,www.shop.omuwenga.com,localhost,127.0.0.1,backend,completebytepos_backend

POSTGRES_DB=completebytepos
POSTGRES_USER=completebytepos
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5432

DB_HOST=db
DB_PORT=5432
DB_NAME=completebytepos
DB_USER=completebytepos
DB_PASSWORD=replace-with-strong-password
DB_CONN_MAX_AGE=300

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=800

POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=128MB

LANGUAGE_CODE=en-us
TIME_ZONE=Africa/Nairobi

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
# Optional overrides — settings also derive https:// + http:// from PUBLIC_HOST
CORS_ALLOWED_ORIGINS=https://shop.omuwenga.com,http://shop.omuwenga.com
CSRF_TRUSTED_ORIGINS=https://shop.omuwenga.com,http://shop.omuwenga.com

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
# Required when host nginx/Caddy terminates TLS and proxies to :3000
USE_SECURE_PROXY_SSL_HEADER=True

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

REACT_APP_API_URL=/api
FRONTEND_PORT=3000

LOG_LEVEL=WARNING
